let toastTimer = null;
function showToast(message, type = "success", durationMs = 4500) {
  const toast = el("studio-toast");
  const msgEl = el("studio-toast-msg");
  const iconEl = el("studio-toast-icon");
  if (!toast) return;

  const themes = {
    success: { bg: "bg-emerald-950/95", border: "border-emerald-400", text: "text-emerald-200", icon: "✅" },
    warning: { bg: "bg-amber-950/95", border: "border-amber-400", text: "text-amber-200", icon: "⚠️" },
    error: { bg: "bg-rose-950/95", border: "border-rose-400", text: "text-rose-200", icon: "❌" },
    info: { bg: "bg-indigo-950/95", border: "border-indigo-400", text: "text-indigo-200", icon: "ℹ️" }
  };
  const theme = themes[type] || themes.success;

  toast.className = `fixed top-5 left-1/2 -translate-x-1/2 z-50 px-6 py-3.5 rounded-2xl shadow-2xl font-bold text-xs md:text-sm border backdrop-blur-xl transition-all duration-300 flex items-center gap-2.5 ${theme.bg} ${theme.border} ${theme.text}`;
  iconEl.textContent = theme.icon;
  msgEl.textContent = message;
  toast.classList.remove("hidden");

  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => {
    toast.classList.add("hidden");
  }, durationMs);
}

async function callColabPython(funcName, args = []) {
  if (window.google && window.google.colab && window.google.colab.kernel) {
    try {
      const res = await window.google.colab.kernel.invokeFunction(funcName, args, {});
      if (res && res.data) {
        if (res.data["application/json"]) {
          return res.data["application/json"];
        }
        if (res.data["text/plain"]) {
          let raw = res.data["text/plain"].trim();
          if ((raw.startsWith("'") && raw.endsWith("'")) || (raw.startsWith('"') && raw.endsWith('"'))) {
            raw = raw.slice(1, -1);
          }
          try {
            return JSON.parse(raw);
          } catch (_) {
            return raw;
          }
        }
      }
    } catch (rpcErr) {
      console.warn("Colab RPC invocation error:", rpcErr);
      return null;
    }
  }
  return null;
}

