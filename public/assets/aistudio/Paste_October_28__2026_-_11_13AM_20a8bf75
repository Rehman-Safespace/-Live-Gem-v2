async function executeDeepThinkingTurn(userText, inlineAudioObj = null, inputModality = "text") {
  readStateFromUI();
  const apiKey = state.config.api_key;
  if (!apiKey) {
    setStatus("⚠️ أدخل مفتاح Google AI Studio API أولاً في الأعلى", "rose");
    showToast("⚠️ يرجى إدخال مفتاح Google AI Studio API أولاً", "error", 4000);
    return;
  }

  if (state.isGeneratingTurn) return;
  state.isGeneratingTurn = true;

  const preferred = state.config.preferred_model || "gemini-3.8-flash";
  const candidateModels = [
    preferred,
    ...THINKING_MODEL_CHAIN.filter(m => m !== preferred)
  ].filter(m => !state.deadModels.has(m));

  if (candidateModels.length === 0) {
    state.deadModels.clear();
    candidateModels.push(...THINKING_MODEL_CHAIN);
  }

  const ai = new GoogleGenAI({ apiKey });
  const budget = parseInt(state.config.thinking_budget ?? 24576, 10);

  const contents = [];
  const recentTurns = state.turns.slice(-14);
  for (const t of recentTurns) {
    if (t.user_input) {
      contents.push({ role: "user", parts: [{ text: t.user_input }] });
    }
    if (t.model_output) {
      contents.push({ role: "model", parts: [{ text: t.model_output }] });
    }
  }

  const currentParts = [];
  for (const f of state.attachedFiles) {
    if (f.file_uri) {
      currentParts.push({
        fileData: {
          fileUri: f.file_uri,
          mimeType: f.mime_type || "text/plain"
        }
      });
    } else if (f.inline_data) {
      currentParts.push({
        inlineData: {
          data: f.inline_data,
          mimeType: f.mime_type || "application/octet-stream"
        }
      });
    }
  }

  if (inlineAudioObj && inlineAudioObj.data) {
    currentParts.push({
      inlineData: {
        data: inlineAudioObj.data,
        mimeType: inlineAudioObj.mimeType || "audio/webm"
      }
    });
  }

  // Enforce MONAD v6.2 / Sheikh Gemini Persona Lock directly on the user turn prompt!
  const effectivePromptText = userText
    ? buildUserTurnPromptWithPersonaLock(userText)
    : (inlineAudioObj
        ? buildUserTurnPromptWithPersonaLock("استمع إلى هذه الرسالة الصوتية بعناية، وفرّغ محتواها ذهنياً ثم فككها ورد عليها بعمق طبقاً لبروتوكول MONAD v6.2 والسجل الثابت وملفات QURAN_PART_1..10.")
        : buildUserTurnPromptWithPersonaLock("حلل الملفات العشرة المرفقة في السياق (QURAN_PART_1 إلى QURAN_PART_10) بدقة طبقاً لبروتوكول MONAD v6.2."));

  currentParts.push({ text: effectivePromptText });
  contents.push({ role: "user", parts: currentParts });

  const msgBubble = appendMessageToUI("model", "⏳ جاري التفكير العميق وتنفيذ بروتوكول MONAD v6.2 (High Thinking)...", "", preferred);
  const textBodyEl = msgBubble.querySelector(".msg-text-body");
  const thoughtsDetailsEl = msgBubble.querySelector("details");
  const thoughtsBodyEl = msgBubble.querySelector(".msg-thoughts-body");

  let finalAnswer = "";
  let finalThoughts = "";
  let usedModel = preferred;
  let succeeded = false;
  let lastErrorMsg = "";
  let latestUsageMeta = null;

  for (const modelId of candidateModels) {
    try {
      usedModel = modelId;
      setStatus(`🧠 جاري التفكير العميق عبر (${modelId} — HIGH ${budget.toLocaleString()} tok)...`, "purple");

      const genConfig = {
        systemInstruction: buildCompiledSystemInstruction(),
        temperature: Number(state.config.temperature ?? 0.7)
      };

      if (budget > 0) {
        genConfig.thinkingConfig = {
          includeThoughts: true,
          thinkingBudget: budget
        };
      }

      const responseStream = await ai.models.generateContentStream({
        model: modelId,
        contents: contents,
        config: genConfig
      });

      finalAnswer = "";
      finalThoughts = "";

      for await (const chunk of responseStream) {
        if (chunk?.usageMetadata) {
          latestUsageMeta = chunk.usageMetadata;
        }
        const parts = chunk?.candidates?.[0]?.content?.parts || [];
        for (const p of parts) {
          if (p.thought && p.text) {
            finalThoughts += p.text;
            if (state.config.show_thinking_trace && thoughtsDetailsEl && thoughtsBodyEl) {
              thoughtsDetailsEl.classList.remove("hidden");
              thoughtsBodyEl.textContent = finalThoughts;
            }
          } else if (p.text) {
            finalAnswer += p.text;
            if (textBodyEl) textBodyEl.textContent = finalAnswer;
            updateLiveCaption("model", finalAnswer, true);
          }
        }
        el("chat-stream").scrollTop = el("chat-stream").scrollHeight;
      }

      if (!finalAnswer && finalThoughts.trim()) {
        finalAnswer = finalThoughts;
      }

      succeeded = true;
      break;
    } catch (err) {
      lastErrorMsg = err?.message || String(err);
      console.warn(`Model ${modelId} failed, cascading to next:`, lastErrorMsg);
      if (lastErrorMsg.includes("404") || lastErrorMsg.includes("not found") || lastErrorMsg.includes("not supported")) {
        state.deadModels.add(modelId);
      }
    }
  }

  state.isGeneratingTurn = false;

  if (succeeded) {
    if (!finalAnswer.trim()) {
      finalAnswer = "تمت المعالجة بنجاح.";
    }
    if (textBodyEl) textBodyEl.textContent = finalAnswer;
    const headerSpan = msgBubble.querySelector("span span");
    if (headerSpan) headerSpan.textContent = `Gemini (${usedModel})`;

    updateLiveCaption("model", finalAnswer, false);

    // Record exact server usageMetadata if present, switching badge to "✅ رسمي من السيرفر"
    const hasServerMeta = Boolean(latestUsageMeta && latestUsageMeta.promptTokenCount);
    const promptTok = latestUsageMeta?.promptTokenCount || (estimateTokensFromText(buildCompiledSystemInstruction()) + estimateTokensFromText(userText));
    const candTok = latestUsageMeta?.candidatesTokenCount || estimateTokensFromText(finalAnswer);
    const thinkTok = latestUsageMeta?.thoughtsTokenCount || estimateTokensFromText(finalThoughts);
    recordQuotaUsage(promptTok, candTok, thinkTok, true, hasServerMeta);

    const nowStamp = new Date().toISOString().replace("T", " ").slice(0, 19);
    state.turns.push({
      turn_index: state.turns.length + 1,
      timestamp: nowStamp,
      input_modality: inputModality,
      user_input: userText || "[رسالة صوتية / مرفقات]",
      thinking_trace: finalThoughts,
      model_output: finalAnswer,
      model_used: usedModel,
      thinking_budget_used: budget,
      voice_name_used: state.config.voice_name,
      voice_state_used: state.config.voice_state,
      tokens_used: { prompt: promptTok, output: candTok, thinking: thinkTok, official_server_count: hasServerMeta },
      reference_files_active: state.attachedFiles.map(f => f.display_name)
    });

    // Non-blocking background save to Google Drive Vault
    if (state.config.auto_save_vault) {
      saveCurrentSessionToVault(false, "ACTIVE");
    }

    setStatus(`✅ اكتمل الرد عبر (${usedModel})`, "emerald");
    if (state.config.auto_speak_reply) {
      await speakTextWithGeminiFlashTTS(finalAnswer);
    }
  } else {
    if (textBodyEl) {
      textBodyEl.textContent = `❌ تعذر الاتصال بالنماذج. السبب: ${lastErrorMsg}`;
      textBodyEl.classList.add("text-rose-400");
    }
    setStatus(`❌ خطأ في الاتصال: ${lastErrorMsg.slice(0, 65)}`, "rose");
  }
}

