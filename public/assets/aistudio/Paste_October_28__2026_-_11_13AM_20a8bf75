def sanitize_title_slug(title_str):
    raw = str(title_str or "جلسة_الشيخ_جيمناي").strip()
    slug = re.sub(r'[^a-zA-Z0-9_\u0600-\u06FF\-]+', '_', raw)
    slug = re.sub(r'_+', '_', slug).strip('_')
    return slug[:65] or "جلسة_الشيخ_جيمناي"


def allocate_versioned_session_file(vault_dir, base_title):
    os.makedirs(vault_dir, exist_ok=True)
    slug = sanitize_title_slug(base_title)
    slug = re.sub(r'_v\d{2,4}$', '', slug, flags=re.IGNORECASE)

    max_ver = 0
    pattern = re.compile(r'^' + re.escape(slug) + r'_v(\d+)(?:_.*)?\.(?:json|md)$', re.IGNORECASE)

    try:
        with os.scandir(vault_dir) as it:
            for entry in it:
                m = pattern.match(entry.name)
                if m:
                    v_num = int(m.group(1))
                    if v_num > max_ver:
                        max_ver = v_num
    except Exception:
        pass

    next_ver = max_ver + 1
    ts_str = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    while True:
        ver_tag = f"v{next_ver:03d}"
        base_fname = f"{slug}_{ver_tag}_{ts_str}"
        json_p = os.path.join(vault_dir, f"{base_fname}.json")
        md_p = os.path.join(vault_dir, f"{base_fname}.md")
        if not os.path.exists(json_p) and not os.path.exists(md_p):
            return json_p, md_p, ver_tag, slug
        next_ver += 1


