def launch_gemini_live_thinking_studio():
    cfg = load_personal_config()
    startup_cached = load_cached_root_sources_on_startup()
    startup_vault = _list_memory_vault_sessions_dict(cfg.get("memory_vault_folder", DEFAULT_MEMORY_VAULT_DIR))
    initial_cfg_json = json.dumps(cfg, ensure_ascii=False)
    builtin_personas_json = json.dumps(BUILTIN_PERSONAS, ensure_ascii=False)
    vocal_states_json = json.dumps(VOCAL_STATES_CATALOG, ensure_ascii=False)
    voice_profiles_json = json.dumps(VOICE_PROFILES_CATALOG, ensure_ascii=False)
    startup_cached_json = json.dumps(startup_cached, ensure_ascii=False)
    startup_vault_json = json.dumps(startup_vault, ensure_ascii=False)
    html_code = (
        HTML_TEMPLATE
        .replace("__INITIAL_CFG_JSON__", initial_cfg_json)
        .replace("__BUILTIN_PERSONAS_JSON__", builtin_personas_json)
        .replace("__VOCAL_STATES_JSON__", vocal_states_json)
        .replace("__VOICE_PROFILES_JSON__", voice_profiles_json)
        .replace("__STARTUP_CACHED_ROOT_JSON__", startup_cached_json)
        .replace("__STARTUP_VAULT_LIST_JSON__", startup_vault_json)
    )
    display(HTML(html_code))


launch_gemini_live_thinking_studio()