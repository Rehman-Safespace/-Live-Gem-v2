async function probeExactContextCountTokens() {
  readStateFromUI();
  const apiKey = state.config.api_key;
  const probeBox = el("quota-probe-details");
  if (!apiKey) {
    showToast("⚠️ أدخل مفتاح API أولاً لحساب التوكنز الرسمي من السيرفر", "warning", 3500);
    return;
  }

  if (probeBox) {
    probeBox.innerHTML = `<span class="text-purple-300">⏳ جاري إرسال البيرسونا وسجل المحادثة إلى <code>POST /v1beta/models/{model}:countTokens</code> لحساب التوكنز الرسمي...</span>`;
  }

  const preferred = state.config.preferred_model || "gemini-3.8-flash";
  const modelsToTry = [preferred, "gemini-2.5-flash", "gemini-2.0-flash"];
  const compiledSys = buildCompiledSystemInstruction();
  const draftMsg = (el("inp-chat-msg")?.value || "").trim();

  const contents = [];
  contents.push({ role: "user", parts: [{ text: compiledSys }] });
  for (const t of state.turns.slice(-14)) {
    if (t.user_input) contents.push({ role: "user", parts: [{ text: t.user_input }] });
    if (t.model_output) contents.push({ role: "model", parts: [{ text: t.model_output }] });
  }
  if (draftMsg) {
    contents.push({ role: "user", parts: [{ text: draftMsg }] });
  }

  for (const mId of modelsToTry) {
    try {
      const url = `https://generativelanguage.googleapis.com/v1beta/models/${mId}:countTokens?key=${encodeURIComponent(apiKey)}`;
      const resp = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ contents })
      });
      if (resp.ok) {
        const data = await resp.json();
        const exactTokens = parseInt(data.totalTokens || 0, 10);
        if (exactTokens > 0) {
          state.telemetry.lastPromptTokens = exactTokens;
          state.telemetry.tokenSource = "server_count_tokens";
          renderQuotaAndTokenTelemetry();
          if (probeBox) {
            probeBox.innerHTML = `
              <div class="bg-slate-900 p-2.5 rounded border border-purple-500/40 text-emerald-300 font-bold">
                ✅ نتيجة <code>POST /v1beta/models/${escapeHtml(mId)}:countTokens</code> الرسمية من سيرفر جوجل:<br>
                • إجمالي التوكنز الفعلي للبيرسونا (MONAD v6.2 + السجل الثابت) + المحادثة الحالية = <span class="text-cyan-200 text-sm">${exactTokens.toLocaleString()} توكن بالضبط!</span>
              </div>
            `;
          }
          showToast(`🧮 العدد الرسمي من سيرفر جوجل (:countTokens): ${exactTokens.toLocaleString()} توكن!`, "success", 4500);
          return;
        }
      }
    } catch (_) {}
  }

  if (probeBox) {
    probeBox.innerHTML = `<span class="text-rose-400">⚠️ تعذر استدعاء :countTokens حالياً — تأكد من صلاحية مفتاح API.</span>`;
  }
}

function renderQuotaAndTokenTelemetry() {
  const limits = getEffectiveQuotaLimits();
  const now = Date.now();
  const t = state.telemetry;

  t.minuteRequestsLog = t.minuteRequestsLog.filter(ts => (now - ts) < 60000);
  t.minuteTokensLog = t.minuteTokensLog.filter(item => (now - item.ts) < 60000);

  const rpmUsed = t.minuteRequestsLog.length;
  const tpmUsed = t.minuteTokensLog.reduce((acc, item) => acc + item.tokens, 0);

  const sysTokens = estimateTokensFromText(buildCompiledSystemInstruction());
  const historyTokens = state.turns.reduce((acc, turn) => {
    return acc + estimateTokensFromText(turn.user_input) + estimateTokensFromText(turn.model_output);
  }, 0);

  const isExactServer = (
    (t.tokenSource === "server_usage_metadata" || t.tokenSource === "server_count_tokens") &&
    t.lastPromptTokens > 0
  );
  const currentContextUsed = isExactServer ? t.lastPromptTokens : (sysTokens + historyTokens);
  const ctxLimit = limits.ctxLimit;
  const ctxRemaining = Math.max(0, ctxLimit - currentContextUsed);
  const ctxPct = Math.min(100, (currentContextUsed / ctxLimit) * 100);

  const provBadge = el("badge-token-provenance");
  if (provBadge) {
    if (t.tokenSource === "server_usage_metadata" && t.lastPromptTokens > 0) {
      provBadge.className = "text-[9px] px-1.5 py-0.5 rounded bg-emerald-950/90 text-emerald-300 border border-emerald-500/50 font-mono font-bold";
      provBadge.textContent = "✅ رسمي من السيرفر (usageMetadata)";
    } else if (t.tokenSource === "server_count_tokens" && t.lastPromptTokens > 0) {
      provBadge.className = "text-[9px] px-1.5 py-0.5 rounded bg-purple-950/90 text-purple-200 border border-purple-500/50 font-mono font-bold";
      provBadge.textContent = "✅ رسمي من السيرفر (:countTokens)";
    } else {
      provBadge.className = "text-[9px] px-1.5 py-0.5 rounded bg-amber-950/90 text-amber-300 border border-amber-500/40 font-mono";
      provBadge.textContent = `⏳ تقديري محلي (~${sysTokens.toLocaleString()} توكن بيرسونا)`;
    }
  }

  if (el("lbl-ctx-tokens")) {
    el("lbl-ctx-tokens").textContent = `${currentContextUsed.toLocaleString()} / ${ctxLimit.toLocaleString()}`;
  }
  if (el("bar-ctx-tokens")) {
    el("bar-ctx-tokens").style.width = `${Math.max(0.5, ctxPct)}%`;
  }
  if (el("lbl-ctx-remaining")) {
    el("lbl-ctx-remaining").textContent = `المتبقي: ${ctxRemaining.toLocaleString()} (${(100 - ctxPct).toFixed(1)}%)`;
  }
  if (el("lbl-last-turn-tokens")) {
    el("lbl-last-turn-tokens").textContent = `آخر دور: ${t.lastTotalTokens.toLocaleString()} توكن`;
  }

  const budget = parseInt(el("sel-thinking-budget")?.value || state.config.thinking_budget || 24576, 10);
  const thinkUsed = t.lastThinkingTokens;
  const thinkRem = Math.max(0, budget - thinkUsed);
  const thinkPct = budget > 0 ? Math.min(100, (thinkUsed / budget) * 100) : 0;

  if (el("lbl-think-tokens")) {
    el("lbl-think-tokens").textContent = `${thinkUsed.toLocaleString()} / ${budget.toLocaleString()}`;
  }
  if (el("bar-think-tokens")) {
    el("bar-think-tokens").style.width = `${thinkPct}%`;
  }
  if (el("lbl-think-remaining")) {
    el("lbl-think-remaining").textContent = `المتبقي للدور: ${thinkRem.toLocaleString()} توكن`;
  }
  if (el("lbl-total-think-session")) {
    el("lbl-total-think-session").textContent = `إجمالي التفكير: ${t.sessionThinkingTokens.toLocaleString()}`;
  }

  const rpmRem = Math.max(0, limits.rpmLimit - rpmUsed);
  const tpmRem = Math.max(0, limits.tpmLimit - tpmUsed);
  const rpdRem = Math.max(0, limits.rpdLimit - t.dailyRequestsUsed);

  if (el("lbl-quota-rpm")) {
    el("lbl-quota-rpm").textContent = `متبقي ${rpmRem.toLocaleString()} / ${limits.rpmLimit.toLocaleString()}`;
  }
  if (el("lbl-quota-tpm")) {
    const tpmRemM = (tpmRem / 1000000).toFixed(2) + "M";
    const tpmLimM = (limits.tpmLimit / 1000000).toFixed(1).replace(/\.0$/, "") + "M";
    el("lbl-quota-tpm").textContent = `متبقي ${tpmRemM} / ${tpmLimM}`;
  }
  if (el("lbl-quota-rpd")) {
    el("lbl-quota-rpd").textContent = `متبقي ${rpdRem.toLocaleString()} / ${limits.rpdLimit.toLocaleString()}`;
  }

  const breakdownEl = el("quota-modal-live-breakdown");
  if (breakdownEl) {
    breakdownEl.innerHTML = `
      <div class="bg-slate-900 p-2 rounded border border-slate-800">
        <div class="text-slate-400">توكنز البيرسونا (MONAD v6.2 + Ledger)</div>
        <div class="text-cyan-300 font-bold">~${sysTokens.toLocaleString()} tok</div>
