async function playSpeakerTestTone() {
  try {
    const ctx = await ensureOutputAudioContext();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = "sine";
    osc.frequency.setValueAtTime(528, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(660, ctx.currentTime + 0.25);
    gain.gain.setValueAtTime(0.25 * state.outputVolume, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.45);
    osc.connect(gain);
    gain.connect(ctx.destination);
    setSpeakerActivityState("speaking", "🔔 نغمة اختبار المخرج...");
    osc.start();
    osc.stop(ctx.currentTime + 0.45);
    setTimeout(() => setSpeakerActivityState("idle"), 500);
    setStatus("🔔 تم إرسال نغمة اختبار إلى كارت الصوت المحدد!", "emerald");
  } catch (e) {
    setStatus("⚠️ تعذر تشغيل نغمة الاختبار", "rose");
  }
}

