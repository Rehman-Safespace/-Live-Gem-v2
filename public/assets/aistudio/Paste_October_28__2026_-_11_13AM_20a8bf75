async function loadExplorerDirectory(dirPath = "", forceRefresh = false) {
  const container = el("exp-items-container");
  if (!container) return;

  const cacheKey = dirPath || "__ROOT__";
  const now = Date.now();

  if (!forceRefresh && state.explorerClientCache.has(cacheKey)) {
    const cached = state.explorerClientCache.get(cacheKey);
    if ((now - cached.ts) < 60000) {
      renderExplorerPayload(cached.res, true);
      return;
    }
  }

  container.innerHTML = `<div class="text-cyan-300 p-3 text-center text-xs font-bold">⚡ جاري المسح السريع (Turbo scandir)...</div>`;
  const res = await callColabPython("studio.browse_drive", [dirPath, forceRefresh]);
  if (!res || res.status !== "ok") {
    container.innerHTML = `<div class="text-rose-400 p-3 text-xs">⚠️ تعذر قراءة المسار (${escapeHtml(res?.message || "تأكد من تشغيل الخلية في Google Colab")}). اضغط على (🛠️ فحص Drive) بالأعلى.</div>`;
    return;
  }

  state.explorerClientCache.set(cacheKey, { ts: now, res });
  state.explorerClientCache.set(res.current_dir, { ts: now, res });
  renderExplorerPayload(res, false);
}

function renderExplorerPayload(res, fromJsCache = false) {
  state.currentExplorerDir = res.current_dir;
  state.currentExplorerItems = res.items || [];
  if (el("inp-exp-manual-path")) el("inp-exp-manual-path").value = res.current_dir;
  if (el("inp-exp-instant-filter")) el("inp-exp-instant-filter").value = "";

  const speedBadge = el("lbl-explorer-speed");
  if (speedBadge) {
    if (fromJsCache) {
      speedBadge.textContent = "⚡ 0ms (JS RAM Cache)";
    } else if (res.from_ram_cache) {
      speedBadge.textContent = `⚡ ${res.scan_ms || 1}ms (Python RAM Cache)`;
    } else {
      speedBadge.textContent = `⚡ ${res.scan_ms || 5}ms (${res.folder_count} فولدر | ${res.file_count} ملف)`;
    }
  }

  el("btn-exp-up").onclick = () => loadExplorerDirectory(res.parent_dir, false);

  const jumpsBar = el("exp-quick-jumps-bar");
  if (jumpsBar && Array.isArray(res.quick_jumps)) {
    jumpsBar.innerHTML = `<span class="text-[10px] text-slate-400 shrink-0 font-bold">قفز فوري:</span>`;
    res.quick_jumps.forEach((qj) => {
      const btn = document.createElement("button");
      const isCurrent = (qj.path === res.current_dir);
      btn.className = `px-2.5 py-1 rounded-lg text-[11px] font-bold shrink-0 transition ${
        isCurrent
          ? "bg-cyan-600 text-white shadow"
          : "bg-slate-800 hover:bg-slate-700 text-cyan-200 border border-slate-700"
      }`;
      btn.textContent = qj.label;
      btn.onclick = () => loadExplorerDirectory(qj.path, false);
      jumpsBar.appendChild(btn);
    });
  }

  renderFilteredExplorerItems("");
}

