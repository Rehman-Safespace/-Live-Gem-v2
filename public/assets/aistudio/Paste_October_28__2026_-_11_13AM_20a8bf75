def _list_memory_vault_sessions_dict(vault_dir=""):
    """
    ⚡ Incremental RAM-cached Vault Session Lister:
    Uses `os.scandir()` and `_VAULT_META_CACHE` keyed by `(full_path, mtime)` so unchanged JSON
    files are NEVER re-opened or re-parsed!
    """
    resolved_dir = resolve_drive_path(vault_dir) or DEFAULT_MEMORY_VAULT_DIR
    if not os.path.exists(resolved_dir):
        try:
            os.makedirs(resolved_dir, exist_ok=True)
        except Exception:
            pass

    sessions = []
    try:
        entries = []
        with os.scandir(resolved_dir) as it:
            for entry in it:
                if not entry.name.lower().endswith('.json') or entry.name.startswith('.'):
                    continue
                try:
                    st = entry.stat(follow_symlinks=True)
                    entries.append((entry.name, entry.path, st.st_mtime))
                except Exception:
                    continue

        entries.sort(key=lambda x: x[2], reverse=True)
        for fname, full_p, mtime in entries[:60]:
            cached = _VAULT_META_CACHE.get(full_p)
            if cached and abs(cached["mtime"] - mtime) < 0.01:
                sessions.append(cached["meta"])
                continue

            try:
                with open(full_p, 'r', encoding='utf-8') as f:
                    doc = json.load(f)
                meta = doc.get("session_metadata", {})
                turns = doc.get("conversation_turns", []) or doc.get("messages", [])
                title = meta.get("title") or doc.get("title") or os.path.splitext(fname)[0]
                ver_tag = meta.get("version_tag", "v001")
                session_status = meta.get("session_status", "SAVED")
                updated_at = meta.get("updated_at") or datetime.datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M:%S")
                llm_model = meta.get("llm_model") or doc.get("model", "gemini-3.8-flash")
                voice_name = meta.get("voice_name", "Sadaltager")
                last_snippet = ""
                if turns:
                    last_t = turns[-1]
                    last_snippet = (last_t.get("model_output") or last_t.get("user_input") or last_t.get("text") or "")[:130]

                item_meta = {
                    "file_name": fname,
                    "file_path": full_p,
                    "title": title,
                    "version_tag": ver_tag,
                    "session_status": session_status,
                    "updated_at": updated_at,
                    "turn_count": len(turns),
                    "llm_model": llm_model,
                    "voice_name": voice_name,
                    "snippet": last_snippet,
                    "mtime": mtime
                }
                _VAULT_META_CACHE[full_p] = {"mtime": mtime, "meta": item_meta}
                sessions.append(item_meta)
            except Exception:
                continue
    except Exception as e:
        return {"status": "error", "message": str(e), "vault_dir": resolved_dir, "sessions": []}

    return {
        "status": "ok",
        "vault_dir": resolved_dir,
        "count": len(sessions),
        "sessions": sessions
    }


