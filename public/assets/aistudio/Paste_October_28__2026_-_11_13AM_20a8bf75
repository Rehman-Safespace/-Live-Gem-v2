function deriveSmartSessionTitle(firstUserPrompt = "") {
  const currentTitle = (el("inp-session-title")?.value || "").trim();
  if (currentTitle && currentTitle !== "تحليل_الشيخ_جيمناي" && currentTitle !== "جلسة_جديدة") {
    return currentTitle;
  }
  if (firstUserPrompt) {
    const words = firstUserPrompt.replace(/[^\u0600-\u06FFa-zA-Z0-9\s]/g, " ").trim().split(/\s+/).slice(0, 6).join("_");
    if (words.length >= 3) {
      el("inp-session-title").value = words;
      return words;
    }
  }
  return currentTitle || "تحليل_الشيخ_جيمناي";
}

async function saveCurrentSessionToVault(forceNewVersion = false, sessionStatus = "ACTIVE") {
  readStateFromUI();
  if (state.turns.length === 0 && !forceNewVersion) return null;

  const title = deriveSmartSessionTitle(state.turns[0]?.user_input || "");
  const refManifest = state.attachedFiles.map(f => ({
    slot: f.slot || "EXTRA",
    display_name: f.display_name,
    file_uri: f.file_uri || "inline",
    mime_type: f.mime_type || "text/plain"
  }));

  const payload = {
    vault_folder: state.config.memory_vault_folder,
    title: title,
    active_json_path: state.activeVaultJsonPath,
    force_new_version: forceNewVersion,
    session_status: sessionStatus,
    created_at: state.sessionCreatedAt,
    engine_mode: state.config.engine_mode,
    llm_model: state.config.preferred_model,
    live_ws_model: state.config.live_ws_model,
    tts_model: state.config.tts_model,
    thinking_budget: state.config.thinking_budget,
    language_code: state.config.language_code,
    voice_name: state.config.voice_name,
    voice_state: state.config.voice_state,
    token_usage_summary: {
      tokenSource: state.telemetry.tokenSource,
      sessionPromptTokens: state.telemetry.sessionPromptTokens,
      sessionCandidateTokens: state.telemetry.sessionCandidateTokens,
      sessionThinkingTokens: state.telemetry.sessionThinkingTokens,
      sessionTotalTokens: state.telemetry.sessionTotalTokens
    },
    persona_preset: state.config.persona_preset,
    user_name: state.config.user_name,
    user_domain: state.config.user_domain,
    system_instruction: state.config.system_instruction,
    personal_memory_bank: state.config.personal_memory_bank,
    conversation_rules: state.config.conversation_rules,
    vocal_state_directive: getActiveVocalStateDirective(),
    injected_vault_memories: state.injectedVaultMemories.map(m => ({
      file_name: m.file_name,
      title: m.title,
      version_tag: m.version_tag
    })),
    compiled_system_instruction: buildCompiledSystemInstruction(),
    reference_files: refManifest,
    turns: state.turns
  };

  const res = await callColabPython("studio.save_vault_session", [JSON.stringify(payload)]);
  if (res && res.status === "ok") {
    state.activeVaultJsonPath = res.json_path;
    state.activeVaultVersionTag = res.version_tag;
    state.sessionCreatedAt = res.created_at;
    el("lbl-active-vault-file").textContent = `${res.file_name} (${res.turn_count} أدوار)`;
    el("lbl-active-vault-file").title = res.json_path;

    // Update JS catalog directly in RAM without a second Drive RPC scan!
    if (res.summary_entry) {
