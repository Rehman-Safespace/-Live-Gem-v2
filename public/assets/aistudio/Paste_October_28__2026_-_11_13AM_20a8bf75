def _upload_drive_file_to_gemini_dict(file_path, api_key):
    resolved_p = resolve_drive_path(file_path)
    if not resolved_p or not os.path.exists(resolved_p) or not os.path.isfile(resolved_p):
        return {"status": "error", "message": f"الملف غير موجود: {file_path}"}
    if not api_key:
        return {"status": "error", "message": "يرجى إدخال مفتاح Google AI Studio API أولاً."}

    ext = os.path.splitext(resolved_p)[1].lower()
    mime_map = {
        '.mp3': 'audio/mp3', '.wav': 'audio/wav', '.m4a': 'audio/mp4', '.ogg': 'audio/ogg',
        '.opus': 'audio/ogg', '.flac': 'audio/flac', '.aac': 'audio/aac',
        '.mp4': 'video/mp4', '.mov': 'video/quicktime', '.webm': 'video/webm', '.mkv': 'video/x-matroska',
        '.pdf': 'application/pdf', '.txt': 'text/plain', '.md': 'text/plain', '.srt': 'text/plain',
        '.json': 'application/json', '.py': 'text/plain', '.csv': 'text/csv',
        '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.webp': 'image/webp'
    }
    mime_type = mime_map.get(ext, 'text/plain')
    file_size = os.path.getsize(resolved_p)
    display_name = os.path.basename(resolved_p)[:90]
    slot, sort_ord = classify_quran_part_slot(display_name)

    try:
        start_url = f"https://generativelanguage.googleapis.com/upload/v1beta/files?key={api_key}"
        meta_bytes = json.dumps({"file": {"display_name": display_name}}).encode("utf-8")
        init_req = urllib.request.Request(
            start_url,
            data=meta_bytes,
            headers={
                "X-Goog-Upload-Protocol": "resumable",
                "X-Goog-Upload-Command": "start",
                "X-Goog-Upload-Header-Content-Length": str(file_size),
                "X-Goog-Upload-Header-Content-Type": mime_type,
                "Content-Type": "application/json",
            },
            method="POST"
        )
        with urllib.request.urlopen(init_req, timeout=45) as resp:
            upload_url = resp.headers.get("X-Goog-Upload-URL") or resp.headers.get("x-goog-upload-url")

        with open(resolved_p, "rb") as f:
            file_bytes = f.read()

        up_req = urllib.request.Request(
            upload_url,
            data=file_bytes,
            headers={
                "Content-Length": str(file_size),
                "X-Goog-Upload-Offset": "0",
                "X-Goog-Upload-Command": "upload, finalize",
            },
            method="POST"
        )
        with urllib.request.urlopen(up_req, timeout=300) as resp:
            info = json.loads(resp.read().decode("utf-8"))

        file_obj = info.get("file", info)
        remote_name = file_obj.get("name", "")
        file_uri = file_obj.get("uri", "")
        state = file_obj.get("state", "ACTIVE")

        polls = 0
        while state == "PROCESSING" and polls < 30:
            time.sleep(1.5)
            polls += 1
            chk_url = f"https://generativelanguage.googleapis.com/v1beta/{remote_name}?key={api_key}"
            with urllib.request.urlopen(chk_url, timeout=20) as c_resp:
                c_data = json.loads(c_resp.read().decode("utf-8"))
                state = c_data.get("state", "ACTIVE")
                file_uri = c_data.get("uri", file_uri)

        return {
            "status": "ok",
            "full_path": resolved_p,
            "file_uri": file_uri,
            "remote_name": remote_name,
            "display_name": display_name,
            "mime_type": mime_type,
            "size_mb": round(file_size / (1024 * 1024), 2),
            "slot": slot,
            "sort_order": sort_ord
        }
    except Exception as e:
        return {"status": "error", "full_path": resolved_p, "message": str(e)}


def upload_drive_file_to_gemini(file_path, api_key):
    return _rpc_json(_upload_drive_file_to_gemini_dict(file_path, api_key))


def auto_discover_quran_folder(preferred_folder=""):
    candidates = []
    if preferred_folder:
        candidates.append(resolve_drive_path(preferred_folder))
    candidates.extend([
        '/content/drive/MyDrive/MONAD_Sources',
        '/content/drive/MyDrive/Quran_Parts',
        '/content/drive/MyDrive/QURAN_PARTS',
        '/content/drive/MyDrive'
    ])
    for c in candidates:
        if c and os.path.exists(c) and os.path.isdir(c):
            try:
                with os.scandir(c) as it:
                    names = [e.name for e in it if not e.name.startswith('.')]
                if any(classify_quran_part_slot(fn)[0] for fn in names):
                    return c
            except Exception:
                pass
    if preferred_folder and os.path.exists(resolve_drive_path(preferred_folder)):
        return resolve_drive_path(preferred_folder)
    return None


def sync_root_sources_folder(folder_path, api_key):
    """
    ⚡ Parallel Multi-Threaded Root Sources Uploader & Merger (5x faster!):
    Uploads all uncached QURAN_PART_1..10 files concurrently using ThreadPoolExecutor.
    """
    t0 = time.time()
    resolved = auto_discover_quran_folder(folder_path)
    if not resolved or not os.path.exists(resolved) or not os.path.isdir(resolved):
        return _rpc_json({
            "status": "error",
            "message": f"لم يتم العثور على المجلد ({folder_path}). افتح (⚡ مستكشف Google Drive السريع) واختر المجلد بضغطة واحدة."
        })
    if not api_key:
        return _rpc_json({"status": "error", "message": "يرجى إدخال مفتاح Google AI Studio API أولاً."})

    cache = {}
    if os.path.exists(ROOT_CACHE_FILE_PATH):
        try:
            with open(ROOT_CACHE_FILE_PATH, 'r', encoding='utf-8') as f:
                cache = json.load(f)
        except Exception:
            cache = {}

    now = time.time()
    valid_cache = {k: v for k, v in cache.items() if (now - v.get("cached_at", 0)) < 44 * 3600}

    file_entries = []
    with os.scandir(resolved) as it:
        for e in it:
            if not e.name.startswith('.') and e.is_file():
                file_entries.append((e.name, e.path))

    def natural_sort_key(item):
        s = item[0]
        slot, ord_num = classify_quran_part_slot(s)
        return (ord_num, [int(text) if text.isdigit() else text.lower() for text in re.split(r'(\d+)', s)])

    file_entries.sort(key=natural_sort_key)

    merged_db = {
        "merged_at": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "source_folder": resolved,
        "scope": "QURAN_PART_1 TO QURAN_PART_10",
        "parts_status": {f"Q{i}": False for i in range(1, 11)},
        "files_manifest": [],
        "source_excerpts": {}
    }

    results = []
    to_upload = []

    for name, full_p in file_entries:
        slot, sort_ord = classify_quran_part_slot(name)
        if full_p in valid_cache and valid_cache[full_p].get("file_uri"):
            cached_item = dict(valid_cache[full_p])
            cached_item["cached"] = True
            cached_item["slot"] = slot
            cached_item["sort_order"] = sort_ord
            results.append(cached_item)
        else:
            to_upload.append((name, full_p, slot, sort_ord))

    if to_upload:
        with ThreadPoolExecutor(max_workers=5) as pool:
            future_map = {
                pool.submit(_upload_drive_file_to_gemini_dict, full_p, api_key): (name, full_p, slot, sort_ord)
                for (name, full_p, slot, sort_ord) in to_upload
            }
            for fut in as_completed(future_map):
                name, full_p, slot, sort_ord = future_map[fut]
                try:
                    up_res = fut.result()
                    if up_res.get("status") == "ok":
                        item_info = {
                            "display_name": up_res.get("display_name", name),
                            "file_uri": up_res.get("file_uri"),
                            "remote_name": up_res.get("remote_name"),
                            "mime_type": up_res.get("mime_type"),
                            "size_mb": up_res.get("size_mb", 0),
                            "slot": slot,
                            "sort_order": sort_ord,
                            "cached_at": now,
                            "cached": False
                        }
                        valid_cache[full_p] = item_info
                        results.append(item_info)
                except Exception:
                    continue

    results.sort(key=lambda x: x.get("sort_order", 99))

    for item in results:
        slot = item.get("slot")
        if slot and slot.startswith("Q"):
            merged_db["parts_status"][slot] = True
        merged_db["files_manifest"].append({
            "slot": slot or "EXTRA",
            "display_name": item.get("display_name"),
            "file_uri": item.get("file_uri"),
            "mime_type": item.get("mime_type")
        })

    try:
        with open(ROOT_CACHE_FILE_PATH, 'w', encoding='utf-8') as f:
            json.dump(valid_cache, f, ensure_ascii=False, indent=2)
        with open(MERGED_DB_FILE_PATH, 'w', encoding='utf-8') as db_f:
            json.dump(merged_db, db_f, ensure_ascii=False, indent=2)
    except Exception:
        pass

    linked_q_count = sum(1 for k, v in merged_db["parts_status"].items() if v)
    elapsed_s = round(time.time() - t0, 2)
    return _rpc_json({
        "status": "ok",
        "folder": resolved,
        "count": len(results),
        "linked_q_parts": linked_q_count,
        "elapsed_sec": elapsed_s,
        "parts_status": merged_db["parts_status"],
        "merged_db_path": MERGED_DB_FILE_PATH,
        "files": results
    })


def load_cached_root_sources_on_startup():
    now = time.time()
    cached_files = []
    parts_status = {f"Q{i}": False for i in range(1, 11)}
    if os.path.exists(ROOT_CACHE_FILE_PATH):
        try:
            with open(ROOT_CACHE_FILE_PATH, 'r', encoding='utf-8') as f:
                cache = json.load(f)
            for full_p, item in cache.items():
                if (now - item.get("cached_at", 0)) < 44 * 3600 and item.get("file_uri"):
                    slot, sort_ord = classify_quran_part_slot(item.get("display_name", ""))
                    c_item = dict(item)
                    c_item["cached"] = True
                    c_item["slot"] = slot
                    c_item["sort_order"] = sort_ord
                    cached_files.append(c_item)
                    if slot and slot.startswith("Q"):
                        parts_status[slot] = True
            cached_files.sort(key=lambda x: x.get("sort_order", 99))
        except Exception:
            pass
    return {"files": cached_files, "parts_status": parts_status}


