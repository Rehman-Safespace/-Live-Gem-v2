async function toggleMicrophoneLive() {
  readStateFromUI();
  const mode = state.config.engine_mode;

  if (mode === "gemini_app_3_8_thinking") {
    toggleLiveDictation(true);
    return;
  }

  if (state.isRecordingMic) {
    state.isRecordingMic = false;
    clearInterval(state.liveTimerInterval);
    el("btn-live-mic").classList.remove("pulse-ring", "from-rose-600", "to-red-700");
    el("mic-icon").textContent = "🎙️";
    el("mic-label").textContent = "ابدأ تحدث / لايف";
    el("btn-mute-mic").disabled = true;
    setSpeakerActivityState("idle");

    if (mode === "websocket_live" || mode === "websocket_translate") {
      await stopWebSocketLiveSession();
    } else if (state.mediaRecorder && state.mediaRecorder.state !== "inactive") {
      state.mediaRecorder.stop();
    }
    return;
  }

  state.isRecordingMic = true;
  state.liveSeconds = 0;
  el("live-timer").textContent = "00:00";
  state.liveTimerInterval = setInterval(() => {
    state.liveSeconds++;
    const m = String(Math.floor(state.liveSeconds / 60)).padStart(2, "0");
    const s = String(state.liveSeconds % 60).padStart(2, "0");
    el("live-timer").textContent = `${m}:${s}`;
  }, 1000);

  el("btn-live-mic").classList.add("pulse-ring", "from-rose-600", "to-red-700");
  el("mic-icon").textContent = "⏹️";
  el("mic-label").textContent = "إيقاف المايك";

  if (mode === "websocket_live" || mode === "websocket_translate") {
    await startWebSocketLiveSession();
  } else {
    try {
      const audioConstraints = state.selectedInputDeviceId
        ? { deviceId: { exact: state.selectedInputDeviceId } }
        : true;
      const stream = await navigator.mediaDevices.getUserMedia({ audio: audioConstraints });
      state.activeMicStream = stream;
      el("btn-mute-mic").disabled = false;
      setMicMuteState(false);
      setSpeakerActivityState("listening");

      state.recordedChunks = [];
      const mr = new MediaRecorder(stream);
      state.mediaRecorder = mr;

      mr.ondataavailable = (e) => {
        if (e.data.size > 0) state.recordedChunks.push(e.data);
      };
      mr.onstop = async () => {
        stream.getTracks().forEach(t => t.stop());
        state.activeMicStream = null;
        setSpeakerActivityState("idle");
        const audioBlob = new Blob(state.recordedChunks, { type: mr.mimeType || "audio/webm" });
        const reader = new FileReader();
        reader.onloadend = async () => {
          const base64Data = reader.result.split(",")[1];
          const typedNote = el("inp-chat-msg").value.trim();
          el("inp-chat-msg").value = "";
          state.dictationBaseText = "";
          appendMessageToUI("user", typedNote ? `🎙️ [رسالة صوتية] — ${typedNote}` : "🎙️ [رسالة صوتية لـ Gemini 3.8 Flash High Thinking]");
          await executeDeepThinkingTurn(typedNote, {
            mimeType: mr.mimeType || "audio/webm",
            data: base64Data
          }, "recorded_audio");
        };
        reader.readAsDataURL(audioBlob);
      };

      mr.start();
      setStatus("🎙️ جاري تسجيل رسالتك الصوتية للتفكير العميق... اضغط (إيقاف المايك) لإرسالها", "amber");
    } catch (err) {
      state.isRecordingMic = false;
      clearInterval(state.liveTimerInterval);
      el("btn-live-mic").classList.remove("pulse-ring", "from-rose-600", "to-red-700");
      el("mic-icon").textContent = "🎙️";
      el("mic-label").textContent = "ابدأ تحدث / لايف";
      setSpeakerActivityState("idle");
      setStatus("⚠️ يرجى السماح بصلاحية الميكروفون في المتصفح", "rose");
    }
  }
}

async function sendTextTurn(modalityOverride = null) {
  clearTimeout(state.dictationSilenceTimer);
  const txt = el("inp-chat-msg").value.trim();
  if (!txt && state.attachedFiles.length === 0) return;

  const modality = modalityOverride || state.lastUsedInputModality || "text";
  state.lastUsedInputModality = "text";

  el("inp-chat-msg").value = "";
  state.dictationBaseText = "";
  updateLiveCaption("user", txt, false);

  if (
    state.liveWsSession &&
    state.liveWsSession.ws &&
    state.liveWsSession.ws.readyState === WebSocket.OPEN &&
    !state.liveWsSession.isTranslate
  ) {
    appendMessageToUI("user", txt);
    state.liveWsSession.ws.send(JSON.stringify({
      clientContent: {
        turns: [{ role: "user", parts: [{ text: buildUserTurnPromptWithPersonaLock(txt) }] }],
        turnComplete: true
      }
    }));
    setStatus(`⚡ تم إرسال رسالتك إلى جلسة اللايف النشطة (${state.liveWsSession.targetModel})`, "purple");
    return;
  }

  const displayUserTxt = modality === "voice_dictation" ? `🎙️ ${txt}` : (txt || "📎 [تحليل الملفات المرجعية في السياق]");
  appendMessageToUI("user", displayUserTxt);
  await executeDeepThinkingTurn(txt, null, modality);
}

