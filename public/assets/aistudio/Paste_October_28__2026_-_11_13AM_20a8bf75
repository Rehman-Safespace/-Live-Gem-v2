    try:
        with open(resolved_p, 'r', encoding='utf-8') as f:
            doc = json.load(f)

        meta = doc.get("session_metadata", {})
        turns = doc.get("conversation_turns", [])

        digest_lines = [
            f"=== سجل محادثة مسترجع من ذاكرة Drive: {meta.get('title', os.path.basename(resolved_p))} ({meta.get('version_tag', '')}) | التاريخ: {meta.get('updated_at', '')} ==="
        ]
        for idx, t in enumerate(turns[-18:], 1):
            u_in = (t.get("user_input") or "").strip()
            m_out = (t.get("model_output") or "").strip()
            t_trace = (t.get("thinking_trace") or "").strip()
            digest_lines.append(f"[الدور {idx} - {t.get('timestamp', '')}]")
            if u_in:
                digest_lines.append(f"- مدخل المستخدم: {u_in}")
            if t_trace:
                digest_lines.append(f"- خلاصة التفكير: {t_trace[:450]}...")
            if m_out:
                digest_lines.append(f"- رد النموذج: {m_out[:950]}")

        compiled_memory_block = "\n".join(digest_lines)
        return _rpc_json({
            "status": "ok",
            "file_path": resolved_p,
            "file_name": os.path.basename(resolved_p),
            "document": doc,
            "compiled_memory_block": compiled_memory_block
        })
    except Exception as e:
        return _rpc_json({"status": "error", "message": str(e)})


