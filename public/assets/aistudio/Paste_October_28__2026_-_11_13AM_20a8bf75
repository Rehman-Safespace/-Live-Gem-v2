function escapeHtml(str) {
  return String(str || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

function classifyClientFilenameSlot(filename) {
  const lower = String(filename || "").toLowerCase();
  const m = lower.match(/(?:quran[_\-\s]*part|part|q|الجزء)[_\-\s]*0*(10|[1-9])(?![0-9])/);
  if (m) {
    const n = parseInt(m[1], 10);
    if (n >= 1 && n <= 10) return `Q${n}`;
  }
  if (lower.includes("ledger") || lower.includes("immutable")) return "LEDGER";
  if (lower.includes("middleware") || lower.includes("scenario")) return "MIDDLEWARE";
  return null;
}

