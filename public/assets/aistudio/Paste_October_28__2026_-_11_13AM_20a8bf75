function estimateTokensFromText(txt) {
  if (!txt) return 0;
  return Math.max(1, Math.ceil(String(txt).length / 3.2));
}

function recordQuotaUsage(promptTok, candidateTok, thinkingTok, isNewRequest = true, fromServerUsageMeta = false) {
  const now = Date.now();
  const t = state.telemetry;
  const totalTurn = (promptTok || 0) + (candidateTok || 0) + (thinkingTok || 0);

  if (fromServerUsageMeta) {
    t.tokenSource = "server_usage_metadata";
  }

  t.lastPromptTokens = promptTok || 0;
  t.lastCandidateTokens = candidateTok || 0;
  t.lastThinkingTokens = thinkingTok || 0;
  t.lastTotalTokens = totalTurn;

  t.sessionPromptTokens += (promptTok || 0);
  t.sessionCandidateTokens += (candidateTok || 0);
  t.sessionThinkingTokens += (thinkingTok || 0);
  t.sessionTotalTokens += totalTurn;

  if (isNewRequest) {
    t.dailyRequestsUsed += 1;
    t.minuteRequestsLog.push(now);
  }
  if (totalTurn > 0) {
    t.minuteTokensLog.push({ ts: now, tokens: totalTurn });
  }
  renderQuotaAndTokenTelemetry();
}

