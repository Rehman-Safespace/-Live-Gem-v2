  const customTpm = parseInt(state.config.custom_tpm_limit || 0, 10);
  const customRpd = parseInt(state.config.custom_rpd_limit || 0, 10);

  return {
    label: (customRpm > 0 || customTpm > 0 || customRpd > 0) ? `${baseTier.label} + تخصيص يدوي` : baseTier.label,
    rpmLimit: customRpm > 0 ? customRpm : baseTier.rpmLimit,
    tpmLimit: customTpm > 0 ? customTpm : baseTier.tpmLimit,
    rpdLimit: customRpd > 0 ? customRpd : baseTier.rpdLimit,
    ctxLimit: state.telemetry.serverVerifiedInputLimit || baseTier.ctxLimit,
    outLimit: state.telemetry.serverVerifiedOutputLimit || baseTier.outLimit
  };
}

