function recomputeQ10StatusFromAttached() {
  const map = {
    Q1: false, Q2: false, Q3: false, Q4: false, Q5: false,
    Q6: false, Q7: false, Q8: false, Q9: false, Q10: false
  };
  for (const f of state.attachedFiles) {
    const slot = f.slot || classifyClientFilenameSlot(f.display_name);
    if (slot && map.hasOwnProperty(slot)) {
      f.slot = slot;
      map[slot] = true;
    }
  }
  state.q10Status = map;
}

function renderQuran10PartsMatrix() {
  recomputeQ10StatusFromAttached();
  const grid = el("q10-slots-grid");
  const summaryEl = el("lbl-q10-matrix-summary");
  if (!grid) return;

  grid.innerHTML = "";
  let linkedCount = 0;
  for (let i = 1; i <= 10; i++) {
    const slotKey = `Q${i}`;
    const isLinked = Boolean(state.q10Status[slotKey]);
    if (isLinked) linkedCount++;
    const pill = document.createElement("div");
    pill.className = isLinked
      ? "py-1 px-1 rounded-lg bg-emerald-950/90 border border-emerald-500/60 text-emerald-300 font-extrabold shadow-sm"
      : "py-1 px-1 rounded-lg bg-slate-900 border border-slate-800 text-slate-500";
    pill.textContent = isLinked ? `🟢 Q${i}` : `⚪ Q${i}`;
    grid.appendChild(pill);
  }
  if (summaryEl) {
    summaryEl.textContent = `${linkedCount} / 10 Linked`;
    summaryEl.className = linkedCount === 10
      ? "font-mono text-emerald-400 font-extrabold"
      : "font-mono text-amber-300 font-bold";
  }
}

