// ----------------------------------------------------------------------------
// FULL-DUPLEX WEBSOCKET LIVE API (WITH HOT-SWAP RECONNECT & QUOTA TRACKING)
// ----------------------------------------------------------------------------
async function startWebSocketLiveSession(overrideModel = null, isHotSwapReconnect = false) {
  readStateFromUI();
  const apiKey = state.config.api_key;
  if (!apiKey) {
    setStatus("⚠️ أدخل مفتاح Google AI Studio API أولاً", "rose");
    showToast("⚠️ أدخل مفتاح Google AI Studio API أولاً", "error", 4000);
    return;
  }

  stopAllAudioPlayback();
  const mode = state.config.engine_mode;
  let targetModel = overrideModel || el("sel-live-model").value || "gemini-3.5-flash-live-preview";
  if (mode === "websocket_translate") {
    targetModel = "gemini-3.5-live-translate-preview";
  }

  setStatus(`🔌 جاري فتح اتصال مباشر عبر (${targetModel} — ${state.config.voice_name})...`, "amber");

  state.inputAudioCtx = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 16000 });
  await ensureOutputAudioContext();
  state.nextAudioStartTime = 0;

  const workletCode = `
    class LiveMic16kProcessor extends AudioWorkletProcessor {
      constructor() {
        super();
        this.buffer = new Int16Array(1600);
        this.writeIndex = 0;
        this.resampleAccum = 0;
      }
      process(inputs) {
        const input = inputs[0];
        if (!input || input.length === 0) return true;
        const ch = input[0];
        if (!ch || ch.length === 0) return true;

        const inRate = sampleRate || 16000;
        const ratio = inRate / 16000;
        let sumAbs = 0;

        for (let i = 0; i < ch.length; i++) {
          sumAbs += Math.abs(ch[i]);
          this.resampleAccum += 1;
          if (this.resampleAccum >= ratio) {
            this.resampleAccum -= ratio;
            const s = Math.max(-1, Math.min(1, ch[i]));
            this.buffer[this.writeIndex++] = s < 0 ? s * 0x8000 : s * 0x7FFF;
            if (this.writeIndex >= 1600) {
              const outChunk = this.buffer.slice(0, 1600);
              const avgLevel = sumAbs / ch.length;
              this.port.postMessage({ pcm16: outChunk.buffer, level: avgLevel }, [outChunk.buffer]);
              this.writeIndex = 0;
            }
          }
        }
        return true;
      }
    }
    registerProcessor('live-mic-16k-processor', LiveMic16kProcessor);
  `;
  const workletBlob = new Blob([workletCode], { type: "application/javascript" });
  const workletUrl = URL.createObjectURL(workletBlob);
  await state.inputAudioCtx.audioWorklet.addModule(workletUrl);

  const audioConstraints = {
    channelCount: 1,
    echoCancellation: true,
    noiseSuppression: true,
    autoGainControl: true
  };
  if (state.selectedInputDeviceId) {
    audioConstraints.deviceId = { exact: state.selectedInputDeviceId };
  }

  const micStream = await navigator.mediaDevices.getUserMedia({ audio: audioConstraints });
  state.activeMicStream = micStream;
  el("btn-mute-mic").disabled = false;
  setMicMuteState(state.isMicMuted);

  const wsUrl = `wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent?key=${encodeURIComponent(apiKey)}`;
  const ws = new WebSocket(wsUrl);
  let setupCompleted = false;
  let liveInputTranscript = "";
  let liveOutputTranscript = "";
  let liveThoughtsTranscript = "";

  ws.onopen = () => {
    const modelPath = targetModel.startsWith("models/") ? targetModel : `models/${targetModel}`;
    let setupPayload;

    if (mode === "websocket_translate" || targetModel === "gemini-3.5-live-translate-preview") {
      const rawLang = el("sel-language").value;
      const tgtLangCode = rawLang === "auto" ? "ar" : rawLang.split("-")[0];
      setupPayload = {
        setup: {
          model: modelPath,
          generationConfig: {
            responseModalities: ["AUDIO"],
            inputAudioTranscription: {},
            outputAudioTranscription: {},
            translationConfig: {
              targetLanguageCode: tgtLangCode,
              echoTargetLanguage: true
            }
          }
        }
      };
    } else {
      setupPayload = {
        setup: {
          model: modelPath,
          generationConfig: {
            responseModalities: ["AUDIO"],
            speechConfig: {
              voiceConfig: {
                prebuiltVoiceConfig: {
                  voiceName: state.config.voice_name || "Sadaltager"
                }
              }
            }
          },
          systemInstruction: {
            parts: [{ text: buildCompiledSystemInstruction() }]
          },
          inputAudioTranscription: {},
          outputAudioTranscription: {}
        }
      };
    }

    ws.send(JSON.stringify(setupPayload));

    const src = state.inputAudioCtx.createMediaStreamSource(micStream);
    const recorderNode = new AudioWorkletNode(state.inputAudioCtx, "live-mic-16k-processor");
    recorderNode.port.onmessage = (ev) => {
      if (state.isMicMuted || ws.readyState !== WebSocket.OPEN || !setupCompleted) {
        el("audio-meter-bar").style.width = "0%";
        return;
      }
      const { pcm16, level } = ev.data;
      const meterPct = Math.min(100, Math.round((level || 0) * 450));
      el("audio-meter-bar").style.width = `${meterPct}%`;

      const b64Audio = encodeBytesToBase64(new Uint8Array(pcm16));
      ws.send(JSON.stringify({
        realtimeInput: {
          audio: {
            mimeType: "audio/pcm;rate=16000",
            data: b64Audio
          }
        }
      }));
    };
    src.connect(recorderNode);
    recorderNode.connect(state.inputAudioCtx.destination);
  };

  let wsFrameChain = Promise.resolve();
  ws.onmessage = (event) => {
    wsFrameChain = wsFrameChain.then(async () => {
      try {
        const rawText = event.data instanceof Blob ? await event.data.text() : event.data;
        const msg = JSON.parse(rawText);

        if (msg.setupComplete !== undefined) {
          setupCompleted = true;
          setSpeakerActivityState("listening");

          if (mode !== "websocket_translate" && targetModel !== "gemini-3.5-live-translate-preview") {
            const contextParts = [];
            for (const f of state.attachedFiles) {
              if (f.file_uri) {
                contextParts.push({
                  fileData: {
                    fileUri: f.file_uri,
                    mimeType: f.mime_type || "text/plain"
                  }
                });
              }
            }
            if (state.injectedVaultMemories.length > 0) {
              const memDigest = state.injectedVaultMemories.map(m => m.compiled_memory_block).join("\n\n");
              contextParts.push({
                text: `[ذاكرة المحادثات المسترجعة من مخزن Drive — اعتمد عليها في حوارنا الحالي دون نطق رسالة تأكيد الآن]:\n${memDigest}`
              });
            }
            if (isHotSwapReconnect && state.turns.length > 0) {
              const recentSummary = state.turns.slice(-8).map((t, i) => `دور ${i + 1} - المستخدم: ${t.user_input}\nردك السابق: ${t.model_output}`).join("\n---\n");
              contextParts.push({
                text: `[استئناف فوري بعد تحديث الصوت/النموذج لايف — حافظ على سياق الحوار التالي بالكامل وتحدث بالصوت والتون الجديدين دون نطق رسالة تأكيد الآن]:\n${recentSummary}`
              });
            }
            if (contextParts.length > 0) {
              ws.send(JSON.stringify({
                clientContent: {
                  turns: [{ role: "user", parts: contextParts }],
                  turnComplete: false
                }
              }));
            }
          }

          setStatus(`🟢 متصل لايف الآن عبر (${targetModel} — ${state.config.voice_name})! تحدث بحرية`, "emerald");
          if (isHotSwapReconnect) {
            showToast(`✅ تم التحديث اللحظي (Hot-Swap) إلى (${state.config.voice_name} | ${targetModel}) بنجاح!`, "success", 3500);
          }
          return;
        }

        if (msg.serverContent?.inputTranscription?.text) {
          liveInputTranscript += msg.serverContent.inputTranscription.text;
          updateLiveCaption("user", liveInputTranscript.trim(), true);
        }

        if (msg.serverContent?.outputTranscription?.text) {
          liveOutputTranscript += msg.serverContent.outputTranscription.text;
          updateLiveCaption("model", liveOutputTranscript.trim(), true);
        }

        const parts = msg.serverContent?.modelTurn?.parts || [];
        for (const part of parts) {
          if (part.inlineData && part.inlineData.data) {
            enqueuePcm24kChunk(part.inlineData.data, part.inlineData.mimeType || "audio/pcm;rate=24000");
          }
          if (part.thought && part.text) {
            liveThoughtsTranscript += part.text;
          } else if (part.text && !msg.serverContent?.outputTranscription) {
            liveOutputTranscript += part.text;
            updateLiveCaption("model", liveOutputTranscript.trim(), true);
          }
        }

        if (msg.serverContent?.interrupted) {
          for (const s of state.activeAudioSources.values()) {
            try { s.stop(); } catch (_) {}
            state.activeAudioSources.delete(s);
          }
          state.nextAudioStartTime = 0;
          setSpeakerActivityState("listening");
        }

        if (msg.serverContent?.turnComplete) {
          const uText = liveInputTranscript.trim();
          const mText = liveOutputTranscript.trim();
          const tText = liveThoughtsTranscript.trim();

          if (uText) {
            updateLiveCaption("user", uText, false);
            appendMessageToUI("user", `🎙️ ${uText}`);
          }
          if (mText) {
            updateLiveCaption("model", mText, false);
            appendMessageToUI("model", mText, tText, targetModel);
          }
          if (uText || mText) {
            const hasMeta = Boolean(msg.usageMetadata?.promptTokenCount);
            const pTok = msg.usageMetadata?.promptTokenCount || estimateTokensFromText(uText) + 120;
            const cTok = msg.usageMetadata?.candidatesTokenCount || estimateTokensFromText(mText) + 120;
            const thTok = msg.usageMetadata?.thoughtsTokenCount || estimateTokensFromText(tText);
            recordQuotaUsage(pTok, cTok, thTok, true, hasMeta);

            state.turns.push({
              turn_index: state.turns.length + 1,
              timestamp: new Date().toISOString().replace("T", " ").slice(0, 19),
              input_modality: "live_websocket_audio",
              user_input: uText || "[مدخل صوتي مباشر]",
              thinking_trace: tText,
              model_output: mText,
              model_used: targetModel,
              thinking_budget_used: state.config.thinking_budget,
              voice_name_used: state.config.voice_name,
              voice_state_used: state.config.voice_state,
              tokens_used: { prompt: pTok, output: cTok, thinking: thTok, official_server_count: hasMeta },
              reference_files_active: state.attachedFiles.map(f => f.display_name)
            });
            if (state.config.auto_save_vault) {
              saveCurrentSessionToVault(false, "ACTIVE");
            }
          }
          liveInputTranscript = "";
          liveOutputTranscript = "";
          liveThoughtsTranscript = "";
        }
      } catch (parseErr) {
        console.warn("Live WS message parse warning:", parseErr);
      }
    });
  };

  ws.onerror = () => {
    setStatus(`⚠️ تنبيه في اتصال اللايف (${targetModel})`, "rose");
  };

  ws.onclose = async (closeEv) => {
    if (state.isHotSwappingLive) return;
    if (state.isRecordingMic && !setupCompleted && mode === "websocket_live") {
      const currentIdx = LIVE_WS_MODEL_CHAIN.indexOf(targetModel);
      const nextModel = LIVE_WS_MODEL_CHAIN[currentIdx + 1];
      if (nextModel) {
        el("sel-live-model").value = nextModel;
        await stopWebSocketLiveSession();
        await startWebSocketLiveSession(nextModel, isHotSwapReconnect);
        return;
      }
    }
    if (state.isRecordingMic) {
      state.isRecordingMic = false;
      clearInterval(state.liveTimerInterval);
      el("btn-live-mic").classList.remove("pulse-ring", "from-rose-600", "to-red-700");
      el("mic-icon").textContent = "🎙️";
      el("mic-label").textContent = "ابدأ تحدث / لايف";
      el("btn-mute-mic").disabled = true;
    }
    setSpeakerActivityState("idle");
    setStatus(`تم إغلاق اتصال اللايف (${closeEv.reason || "Ready"})`, "emerald");
  };

  state.liveWsSession = {
    ws,
    micStream,
    targetModel,
    isTranslate: (mode === "websocket_translate" || targetModel === "gemini-3.5-live-translate-preview")
  };
}

async function stopWebSocketLiveSession() {
  if (state.liveWsSession) {
    try { state.liveWsSession.ws.close(); } catch (_) {}
    try { state.liveWsSession.micStream.getTracks().forEach(t => t.stop()); } catch (_) {}
    state.liveWsSession = null;
  }
  state.activeMicStream = null;
  el("btn-mute-mic").disabled = true;
  if (state.inputAudioCtx) {
    try { state.inputAudioCtx.close(); } catch (_) {}
    state.inputAudioCtx = null;
  }
  el("audio-meter-bar").style.width = "0%";
  setSpeakerActivityState("idle");
}

