def resolve_drive_path(path):
    if not path or not isinstance(path, str):
        return ""
    raw = path.strip('\r\n\t"\' ')
    if os.path.islink(raw):
        try:
            real_p = os.path.realpath(raw)
            if os.path.exists(real_p):
                return real_p
        except Exception:
            pass
    return raw


def classify_quran_part_slot(filename):
    lower = filename.lower()
    m = re.search(r'(?:quran[_\-\s]*part|part|q|الجزء)[_\-\s]*0*(10|[1-9])(?![0-9])', lower)
    if m:
        num = int(m.group(1))
        if 1 <= num <= 10:
            return (f"Q{num}", num)
    if "ledger" in lower or "immutable" in lower or "monad_core" in lower:
        return ("LEDGER", 11)
    if "middleware" in lower or "scenario" in lower:
        return ("MIDDLEWARE", 12)
    return (None, 99)


def discover_quick_jump_folders():
    """Fast 1-level scan of MyDrive to provide 1-click jump chips in the UI."""
    now = time.time()
    if (now - _QUICK_FOLDERS_CACHE["ts"]) < 120 and _QUICK_FOLDERS_CACHE["folders"]:
        return _QUICK_FOLDERS_CACHE["folders"]

    chips = []
    mydrive = '/content/drive/MyDrive'
    if os.path.exists(mydrive):
        chips.append({"label": "🏠 MyDrive", "path": mydrive})
        try:
            with os.scandir(mydrive) as it:
                for entry in it:
                    if entry.name.startswith('.'):
                        continue
                    try:
                        if entry.is_dir():
                            low = entry.name.lower()
                            if any(k in low for k in ['monad', 'quran', 'source', 'studio', 'vault', 'gemini', 'قرآن', 'مصادر', 'جلسات']):
                                chips.append({"label": f"📁 {entry.name[:24]}", "path": entry.path})
                    except Exception:
                        continue
        except Exception:
            pass
    if os.path.exists(DEFAULT_MEMORY_VAULT_DIR):
        chips.append({"label": "🗄️ خزنة الجلسات الافتراضية", "path": DEFAULT_MEMORY_VAULT_DIR})
    if os.path.exists('/content/drive/.shortcut-targets-by-id'):
        chips.append({"label": "🔗 الشورت كات", "path": '/content/drive/.shortcut-targets-by-id'})

    _QUICK_FOLDERS_CACHE["ts"] = now
    _QUICK_FOLDERS_CACHE["folders"] = chips[:10]
    return _QUICK_FOLDERS_CACHE["folders"]


def browse_drive_directory(dir_path="", force_refresh=False):
    """
    ⚡ TURBO Google Drive Explorer:
    Uses single-pass `os.scandir()` without N+1 subfolder listing or slow stat calls.
    Caches results in Python RAM for 60s so repeat visits take < 1ms.
    """
    t0 = time.time()
    default_root = '/content/drive/MyDrive' if os.path.exists('/content/drive/MyDrive') else os.path.abspath('.')
    target = resolve_drive_path(dir_path) if dir_path else default_root
    if not target or not os.path.exists(target):
        target = default_root

    if os.path.isfile(target):
        target = os.path.dirname(target)

    now = time.time()
    if not force_refresh and target in _DRIVE_DIR_CACHE:
        cached_entry = _DRIVE_DIR_CACHE[target]
        if (now - cached_entry["ts"]) < 60.0:
            payload = dict(cached_entry["payload"])
            payload["from_ram_cache"] = True
            payload["scan_ms"] = 1
            return _rpc_json(payload)

    dirs_list = []
    files_list = []
    try:
        with os.scandir(target) as it:
            for entry in it:
                name = entry.name
                if name.startswith('.') and name != '.shortcut-targets-by-id':
                    continue
                try:
                    is_dir = entry.is_dir(follow_symlinks=True)
                    if is_dir:
                        dirs_list.append({
                            "name": name,
                            "path": entry.path,
                            "is_dir": True,
                            "size_mb": 0,
                            "slot": None
                        })
                    else:
                        try:
                            sz = entry.stat(follow_symlinks=True).st_size
                            size_mb = round(sz / (1024 * 1024), 2)
                        except Exception:
                            size_mb = 0
                        slot, _ = classify_quran_part_slot(name)
                        files_list.append({
                            "name": name,
                            "path": entry.path,
                            "is_dir": False,
                            "size_mb": size_mb,
                            "slot": slot
                        })
                except Exception:
                    continue
    except Exception as e:
        return _rpc_json({
            "status": "error",
            "message": str(e),
            "current_dir": target,
            "items": []
        })

    dirs_list.sort(key=lambda x: x["name"].lower())
    files_list.sort(key=lambda x: x["name"].lower())

    items = (dirs_list + files_list)[:250]
    parent_dir = os.path.dirname(target.rstrip('/')) or '/'
    scan_ms = max(1, int((time.time() - t0) * 1000))

    result_payload = {
        "status": "ok",
        "current_dir": target,
        "parent_dir": parent_dir,
        "folder_count": len(dirs_list),
        "file_count": len(files_list),
        "scan_ms": scan_ms,
        "from_ram_cache": False,
        "quick_jumps": discover_quick_jump_folders(),
        "shortcuts_dir": '/content/drive/.shortcut-targets-by-id' if os.path.exists('/content/drive/.shortcut-targets-by-id') else '',
        "mydrive_dir": default_root,
        "vault_default_dir": DEFAULT_MEMORY_VAULT_DIR,
        "items": items
    }
    _DRIVE_DIR_CACHE[target] = {"ts": now, "payload": result_payload}
    return _rpc_json(result_payload)


