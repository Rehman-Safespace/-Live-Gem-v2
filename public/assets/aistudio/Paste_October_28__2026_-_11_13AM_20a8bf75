async function refreshAudioDevices(requestPermissionFirst = false) {
  try {
    if (requestPermissionFirst) {
      const tempStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      tempStream.getTracks().forEach(t => t.stop());
    }
    const devices = await navigator.mediaDevices.enumerateDevices();
    const inSelect = el("sel-audio-input");
    const outSelect = el("sel-audio-output");
    const prevIn = state.selectedInputDeviceId || inSelect.value;
    const prevOut = state.selectedOutputDeviceId || outSelect.value;

    inSelect.innerHTML = `<option value="">🎤 المايك الافتراضي</option>`;
    outSelect.innerHTML = `<option value="">🔈 كارت الصوت الافتراضي</option>`;

    let inIdx = 1;
    let outIdx = 1;
    for (const d of devices) {
      if (d.kind === "audioinput") {
        const opt = document.createElement("option");
        opt.value = d.deviceId;
        opt.textContent = d.label || `ميكروفون رقم ${inIdx++}`;
        inSelect.appendChild(opt);
      } else if (d.kind === "audiooutput") {
        const opt = document.createElement("option");
        opt.value = d.deviceId;
        opt.textContent = d.label || `كارت صوت رقم ${outIdx++}`;
        outSelect.appendChild(opt);
      }
    }
    if (prevIn) inSelect.value = prevIn;
    if (prevOut) outSelect.value = prevOut;
  } catch (err) {
    setStatus("⚠️ اضغط على (🔄) واسمح بالمايك لإظهار أسماء كروت الصوت", "amber");
  }
}

