// 📱 GEMINI APP VOICE DICTATION ENGINE (WITH AUTO-SEND ON PAUSE & ECHO GUARD)
// ----------------------------------------------------------------------------
function toggleLiveDictation(fromMainMicBtn = false) {
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SpeechRecognition) {
    setStatus("⚠️ متصفحك لا يدعم Web Speech Dictation — استخدم Chrome أو Edge", "rose");
    showToast("⚠️ متصفحك لا يدعم الإملاء الصوتي المباشر — استخدم Chrome أو Edge", "error", 4000);
    return;
  }

  if (state.isDictating && state.speechRecognizer) {
    state.isDictating = false;
    state.handsFreeAppLoop = false;
    clearTimeout(state.dictationSilenceTimer);
    clearInterval(state.liveTimerInterval);
    try { state.speechRecognizer.stop(); } catch (_) {}
    el("btn-dictation").classList.remove("dictation-ring", "bg-cyan-600/50");
    el("dict-icon").textContent = "✍️";
    el("dict-label").textContent = "إملاء صوتي مستمر لـ Gemini 3.8 Flash";
    el("btn-live-mic").classList.remove("pulse-ring", "from-rose-600", "to-red-700");
    el("mic-icon").textContent = "🎙️";
    el("mic-label").textContent = "ابدأ تحدث / لايف";
    el("btn-mute-mic").disabled = true;
    setSpeakerActivityState("idle");
    setStatus("تم إيقاف الإملاء الصوتي", "emerald");
    return;
  }

  const rec = new SpeechRecognition();
  const selLang = el("sel-language").value;
  rec.lang = selLang === "auto" ? "ar-EG" : selLang;
  rec.continuous = true;
  rec.interimResults = true;

  state.dictationBaseText = el("inp-chat-msg").value.trim();
  if (state.dictationBaseText) state.dictationBaseText += " ";

  if (fromMainMicBtn) {
    state.handsFreeAppLoop = true;
    state.liveSeconds = 0;
    el("live-timer").textContent = "00:00";
    clearInterval(state.liveTimerInterval);
    state.liveTimerInterval = setInterval(() => {
      state.liveSeconds++;
      const m = String(Math.floor(state.liveSeconds / 60)).padStart(2, "0");
      const s = String(state.liveSeconds % 60).padStart(2, "0");
      el("live-timer").textContent = `${m}:${s}`;
    }, 1000);
    el("btn-live-mic").classList.add("pulse-ring", "from-rose-600", "to-red-700");
    el("mic-icon").textContent = "⏹️";
    el("mic-label").textContent = "إيقاف المايك";
    el("btn-mute-mic").disabled = false;
  }

  rec.onstart = () => {
    state.isDictating = true;
    el("btn-dictation").classList.add("dictation-ring", "bg-cyan-600/50");
    el("dict-icon").textContent = "🛑";
    el("dict-label").textContent = "إيقاف الإملاء الصوتي (يستمع إليك الآن...)";
    if (state.activeAudioSources.size === 0) {
      setSpeakerActivityState("listening", "🎙️ يستمع إليك (تحدث لـ Gemini 3.8 Flash)...");
    }
    setStatus(`📱 وضع تطبيق جيمناي نشط (${rec.lang}) — تكلم وسيتم الإرسال والرد بصوت جيمناي الطبيعي`, "purple");
  };

  rec.onresult = (event) => {
    if (state.isMicMuted || state.activeAudioSources.size > 0 || state.isGeneratingTurn) {
      return;
    }

    let interimTranscript = "";
    let finalTranscript = "";
    for (let i = event.resultIndex; i < event.results.length; ++i) {
      const transcript = event.results[i][0].transcript;
      if (event.results[i].isFinal) finalTranscript += transcript + " ";
      else interimTranscript += transcript;
    }
    if (finalTranscript) state.dictationBaseText += finalTranscript;
    const combined = (state.dictationBaseText + interimTranscript).trim();
    el("inp-chat-msg").value = combined;
    state.lastUsedInputModality = "voice_dictation";
    updateLiveCaption("user", combined, Boolean(interimTranscript));

    el("audio-meter-bar").style.width = `${Math.min(100, 35 + (combined.length % 60))}%`;

    clearTimeout(state.dictationSilenceTimer);
    if (el("chk-auto-send-dictation")?.checked && combined.length >= 2) {
      state.dictationSilenceTimer = setTimeout(() => {
        if (
          state.isDictating &&
          !state.isMicMuted &&
          !state.isGeneratingTurn &&
          state.activeAudioSources.size === 0 &&
          el("inp-chat-msg").value.trim().length >= 2
        ) {
          el("audio-meter-bar").style.width = "0%";
          sendTextTurn("voice_dictation");
        }
      }, 1850);
    }
  };

  rec.onerror = (err) => {
    if (err.error === "not-allowed") {
      setStatus("⚠️ يرجى السماح بصلاحية المايك في المتصفح للإملاء الصوتي", "rose");
      state.isDictating = false;
      state.handsFreeAppLoop = false;
      setSpeakerActivityState("idle");
    }
  };

  rec.onend = () => {
    if (state.isDictating) {
      try { rec.start(); } catch (_) {}
    }
  };

  state.speechRecognizer = rec;
  rec.start();
}

