// Auto-upgrade any stale localStorage config to MONAD v6.2 so old prompts never dilute the persona
try {
  const localSaved = localStorage.getItem("gemini_live_thinking_cfg");
  if (localSaved) {
    const parsed = JSON.parse(localSaved);
    if (!parsed.persona_preset || parsed.persona_preset === "custom_personal" || parsed.persona_preset === "custom") {
      parsed.persona_preset = "sheikh_gemini";
    }
    if (parsed.persona_preset === "sheikh_gemini" || parsed.persona_preset === "monad_sovereign_v6_2") {
      if (parsed.persona_version !== "6.2.0" || !String(parsed.system_instruction || "").includes("THE 14 ANALOGY ENGINES")) {
        delete parsed.system_instruction;
        delete parsed.personal_memory_bank;
        delete parsed.conversation_rules;
        delete parsed.user_name;
        delete parsed.user_domain;
        parsed.persona_version = "6.2.0";
        parsed.strict_monad_enforcement = true;
      }
    }
    if (!THINKING_MODEL_CHAIN.includes(parsed.preferred_model)) {
      parsed.preferred_model = "gemini-3.8-flash";
    }
    if (!["gemini_app_3_8_thinking", "websocket_live", "deep_thinking_live", "websocket_translate"].includes(parsed.engine_mode)) {
      parsed.engine_mode = "gemini_app_3_8_thinking";
    }
    state.config = Object.assign({}, state.config, parsed, {
      custom_personas: Object.assign({}, (state.config.custom_personas || {}), (parsed.custom_personas || {}))
    });
  }
} catch (_) {}

syncUIFromState();
