function encodeBytesToBase64(bytes) {
  let binary = "";
  for (let i = 0; i < bytes.byteLength; i++) binary += String.fromCharCode(bytes[i]);
  return btoa(binary);
}

function decodeBase64ToBytes(b64) {
  const binary = atob(b64);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return bytes;
}

async function ensureOutputAudioContext() {
  if (!state.outputAudioCtx || state.outputAudioCtx.state === "closed") {
    state.outputAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
    state.outputGainNode = state.outputAudioCtx.createGain();
    state.outputGainNode.gain.value = state.outputVolume;
    state.outputGainNode.connect(state.outputAudioCtx.destination);
    state.nextAudioStartTime = 0;

    if (state.selectedOutputDeviceId && typeof state.outputAudioCtx.setSinkId === "function") {
      try {
        await state.outputAudioCtx.setSinkId(state.selectedOutputDeviceId);
      } catch (_) {}
    }
  }
  if (state.outputAudioCtx.state === "suspended") {
    try {
      await state.outputAudioCtx.resume();
    } catch (_) {}
  }
  if (state.outputGainNode) {
    state.outputGainNode.gain.value = state.outputVolume;
  }
  return state.outputAudioCtx;
}

function enqueuePcm24kChunk(b64Data, mimeType = "audio/pcm;rate=24000") {
  if (!b64Data || !state.outputAudioCtx) return;
  const audioCtx = state.outputAudioCtx;
  const uint8Bytes = decodeBase64ToBytes(b64Data);

  const isWavHeader = (
    uint8Bytes.byteLength > 44 &&
    uint8Bytes[0] === 0x52 && uint8Bytes[1] === 0x49 && uint8Bytes[2] === 0x46 && uint8Bytes[3] === 0x46
  );

  let pcmOffset = isWavHeader ? 44 : 0;
  let sampleRate = 24000;
  const rateMatch = String(mimeType || "").match(/rate=(\d+)/i);
  if (rateMatch) {
    sampleRate = parseInt(rateMatch[1], 10) || 24000;
  } else if (isWavHeader) {
    const view = new DataView(uint8Bytes.buffer, uint8Bytes.byteOffset, uint8Bytes.byteLength);
    const wavRate = view.getUint32(24, true);
    if (wavRate >= 8000 && wavRate <= 96000) sampleRate = wavRate;
  }

  const usableLen = (uint8Bytes.byteLength - pcmOffset) - ((uint8Bytes.byteLength - pcmOffset) % 2);
  if (usableLen <= 0) return;

  const int16 = new Int16Array(uint8Bytes.buffer, uint8Bytes.byteOffset + pcmOffset, usableLen / 2);
  const audioBuffer = audioCtx.createBuffer(1, int16.length, sampleRate);
  const channelData = audioBuffer.getChannelData(0);
  for (let i = 0; i < int16.length; i++) {
    channelData[i] = int16[i] / 32768.0;
  }

  const now = audioCtx.currentTime;
  if (state.nextAudioStartTime < now + 0.005) {
    state.nextAudioStartTime = now + 0.05;
  }

  const sourceNode = audioCtx.createBufferSource();
  sourceNode.buffer = audioBuffer;
  sourceNode.connect(state.outputGainNode || audioCtx.destination);

  setSpeakerActivityState("speaking");

  sourceNode.addEventListener("ended", () => {
    state.activeAudioSources.delete(sourceNode);
    if (state.activeAudioSources.size === 0) {
      if (state.isRecordingMic || state.isDictating) {
        setSpeakerActivityState("listening");
      } else {
        setSpeakerActivityState("idle");
      }
    }
  });

  sourceNode.start(state.nextAudioStartTime);
  state.nextAudioStartTime += audioBuffer.duration;
  state.activeAudioSources.add(sourceNode);
}

function stopAllAudioPlayback() {
  state.ttsGenerationId++;
  if (state.activeTtsWs) {
    try { state.activeTtsWs.close(); } catch (_) {}
    state.activeTtsWs = null;
  }
  for (const s of state.activeAudioSources.values()) {
    try { s.stop(); } catch (_) {}
    state.activeAudioSources.delete(s);
  }
  state.nextAudioStartTime = 0;
  setSpeakerActivityState((state.isRecordingMic || state.isDictating) ? "listening" : "idle");
}

function prepareTextForGeminiTTS(rawText) {
  return String(rawText || "")
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/[*#_`~>|]/g, " ")
    .replace(/\[([^\]]+)\]\([^\)]+\)/g, "$1")
    .replace(/\s+/g, " ")
    .trim();
}

async function speakTextWithGeminiFlashTTS(rawText) {
  readStateFromUI();
  const cleanText = prepareTextForGeminiTTS(rawText);
  if (!cleanText) return;

  state.lastSpokenText = cleanText;

  const apiKey = state.config.api_key;
  if (!apiKey) {
    setStatus("⚠️ أدخل مفتاح API لتشغيل صوت Gemini 3.8 Flash TTS", "rose");
    return;
  }

  stopAllAudioPlayback();
  const myTtsId = state.ttsGenerationId;
  await ensureOutputAudioContext();

  const chosenTtsModel = state.config.tts_model || "gemini-3.8-flash-tts";
  const chosenVoice = state.config.voice_name || "Sadaltager";
  const vocalDirective = getActiveVocalStateDirective();

  setSpeakerActivityState("synthesizing");

  if (chosenTtsModel !== "gemini-3.8-live") {
    const restCandidates = [
      chosenTtsModel,
      ...GEMINI_TTS_REST_CHAIN.filter(m => m !== chosenTtsModel)
    ].filter(m => !state.deadModels.has("tts_rest_" + m));

    const ai = new GoogleGenAI({ apiKey });
    for (const ttsModel of restCandidates) {
      if (myTtsId !== state.ttsGenerationId) return;
      try {
        setStatus(`🔊 جاري توليد الصوت الطبيعي عبر (${ttsModel} — ${chosenVoice})...`, "purple");
        const resp = await ai.models.generateContent({
          model: ttsModel,
          contents: [{
            role: "user",
            parts: [{
              text: `${vocalDirective}\nاقرأ النص التالي بصوت طبيعي وواضح ومعبّر بنفس لهجته ولغته دون إضافة أي كلمة من عندك:\n\n${cleanText}`
            }]
          }],
          config: {
            responseModalities: ["AUDIO"],
            speechConfig: {
              voiceConfig: {
                prebuiltVoiceConfig: {
                  voiceName: chosenVoice
                }
              }
            }
          }
        });

        if (myTtsId !== state.ttsGenerationId) return;
        const parts = resp?.candidates?.[0]?.content?.parts || [];
        let gotAudio = false;
        for (const p of parts) {
          if (p.inlineData && p.inlineData.data) {
            enqueuePcm24kChunk(p.inlineData.data, p.inlineData.mimeType || "audio/pcm;rate=24000");
            gotAudio = true;
          }
        }
        if (gotAudio) {
          const uMeta = resp?.usageMetadata;
          recordQuotaUsage(
            uMeta?.promptTokenCount || estimateTokensFromText(cleanText),
            uMeta?.candidatesTokenCount || 50,
            0,
            true,
            Boolean(uMeta)
          );
          setStatus(`🔊 يتحدث الآن بصوت Gemini الطبيعي (${ttsModel} — ${chosenVoice})`, "emerald");
          return;
        }
      } catch (restErr) {
        const msg = restErr?.message || String(restErr);
        if (msg.includes("404") || msg.includes("not found") || msg.includes("AUDIO")) {
          state.deadModels.add("tts_rest_" + ttsModel);
        }
      }
    }
  }

  if (myTtsId !== state.ttsGenerationId) return;
  await streamGeminiBidiNeuralTTS(cleanText, chosenVoice, vocalDirective, myTtsId);
}

async function streamGeminiBidiNeuralTTS(textToRead, voiceName, vocalDirective, myTtsId, fallbackIndex = 0) {
  if (myTtsId !== state.ttsGenerationId) return;
  const bidiCandidates = [
    state.config.tts_model,
    ...GEMINI_TTS_BIDI_CHAIN,
    state.config.live_ws_model
  ].filter((v, i, a) => v && v !== "gemini-3.5-live-translate-preview" && a.indexOf(v) === i);

  if (fallbackIndex >= bidiCandidates.length) {
    setSpeakerActivityState("idle");
    setStatus("⚠️ تعذر تشغيل خادم الصوت — تأكد من صلاحية المفتاح", "rose");
    return;
  }

  const targetModel = bidiCandidates[fallbackIndex];
  const apiKey = state.config.api_key;
  setStatus(`🔊 جاري القراءة الصوتية الحية عبر (${targetModel} — ${voiceName})...`, "purple");

  const wsUrl = `wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent?key=${encodeURIComponent(apiKey)}`;
  const ws = new WebSocket(wsUrl);
  state.activeTtsWs = ws;
  let receivedAudio = false;
  let setupDone = false;

  ws.onopen = () => {
    if (myTtsId !== state.ttsGenerationId) {
      ws.close();
      return;
    }
    const modelPath = targetModel.startsWith("models/") ? targetModel : `models/${targetModel}`;
    ws.send(JSON.stringify({
      setup: {
        model: modelPath,
        generationConfig: {
          responseModalities: ["AUDIO"],
          speechConfig: {
            voiceConfig: {
              prebuiltVoiceConfig: {
                voiceName: voiceName || "Sadaltager"
              }
            }
          }
        },
        systemInstruction: {
          parts: [{
            text: `أنت قارئ صوتي احترافي فائق الطبيعية (Gemini Neural TTS Reader).\n${vocalDirective}\nمهمتك الوحيدة هي قراءة النص الذي يرسله المستخدم حرفياً وبنفس اللهجة المكتوبة بنبرة بشرية طبيعية وعميقة وواضحة، دون أي مقدمة أو تعليق أو تغيير في الكلمات.`
          }]
        }
      }
    }));
  };

  let ttsFrameChain = Promise.resolve();
  ws.onmessage = (event) => {
    ttsFrameChain = ttsFrameChain.then(async () => {
      if (myTtsId !== state.ttsGenerationId) {
        ws.close();
        return;
      }
      try {
        const raw = event.data instanceof Blob ? await event.data.text() : event.data;
        const msg = JSON.parse(raw);

        if (msg.setupComplete !== undefined) {
          setupDone = true;
          ws.send(JSON.stringify({
            clientContent: {
              turns: [{
                role: "user",
                parts: [{ text: `اقرأ هذا النص فقط بصوتك الطبيعي:\n\n${textToRead}` }]
              }],
              turnComplete: true
            }
          }));
          return;
        }

        const parts = msg.serverContent?.modelTurn?.parts || [];
        for (const part of parts) {
          if (part.inlineData && part.inlineData.data) {
            receivedAudio = true;
            enqueuePcm24kChunk(part.inlineData.data, part.inlineData.mimeType || "audio/pcm;rate=24000");
          }
        }

        if (msg.serverContent?.turnComplete) {
          recordQuotaUsage(estimateTokensFromText(textToRead), 60, 0, true, false);
          setStatus(`🔊 اكتمل تدفق الصوت الطبيعي (${targetModel} — ${voiceName})`, "emerald");
          ws.close();
        }
      } catch (_) {}
    });
  };

  ws.onerror = () => {};

  ws.onclose = () => {
    if (myTtsId !== state.ttsGenerationId) return;
    if (!setupDone || !receivedAudio) {
      streamGeminiBidiNeuralTTS(textToRead, voiceName, vocalDirective, myTtsId, fallbackIndex + 1);
    }
  };
}

